index 0000000..7eafe60
--- /dev/null
+++ b/src/bt/bthid/devices/vendors/magicsee/magicsee_r1_ble.h
@@ -0,0 +1,9 @@
+#ifndef MAGICSEE_R1_BLE_H
+#define MAGICSEE_R1_BLE_H
+
+#include "bt/bthid/bthid.h"
+
+extern const bthid_driver_t magicsee_r1_ble_driver;
+void magicsee_r1_ble_register(void);
+
